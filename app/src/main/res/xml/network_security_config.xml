<?xml version="1.0" encoding="utf-8"?>
<!-- LG TVs are addressed by bare LAN IPs and speak plain ws:// on :3000, so cleartext
     cannot be limited to a domain list. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
